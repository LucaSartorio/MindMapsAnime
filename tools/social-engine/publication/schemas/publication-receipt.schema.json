          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*){2,3}@(?:en|it)(?:\\+[a-z0-9]+(?:-[a-z0-9]+)*)?$",
          "maxLength": 400,
