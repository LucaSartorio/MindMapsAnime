{
  "name": "anime-interactive-maps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run test:seo && vite build && npm run build:ssr && npm run prerender && npm run seo:check",
    "prerender": "tsx --tsconfig scripts/tsconfig.json scripts/prerender.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate:data": "tsx --tsconfig scripts/tsconfig.json scripts/validate-data.ts",
    "validate:i18n": "tsx --tsconfig scripts/tsconfig.json scripts/validate-i18n.ts",
    "coverage:chapters": "tsx --tsconfig scripts/tsconfig.json scripts/chapter-coverage.ts",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "smoke": "npm run build && tsx --tsconfig scripts/tsconfig.json scripts/smoke.ts",
    "extract:boundaries": "tsx --tsconfig scripts/tsconfig.json scripts/extract-boundaries.ts",
    "find:dots": "tsx --tsconfig scripts/tsconfig.json scripts/find-red-dots.ts",
    "optimize:images": "tsx --tsconfig scripts/tsconfig.json scripts/optimize-images.ts",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "seo:check": "tsx --tsconfig scripts/tsconfig.json scripts/seo-check.ts",
    "test:seo": "tsx --tsconfig scripts/tsconfig.json scripts/test-seo.ts",
    "preview:static": "tsx --tsconfig scripts/tsconfig.json scripts/serve-static.ts",
    "seo:slugs": "tsx --tsconfig scripts/tsconfig.json scripts/sync-slugs.ts",
    "i18n:status": "tsx --tsconfig scripts/tsconfig.json scripts/i18n-overlay.ts status",
    "i18n:audit": "tsx --tsconfig scripts/tsconfig.json scripts/i18n-audit.ts",
    "i18n:extract": "tsx --tsconfig scripts/tsconfig.json scripts/i18n-overlay.ts extract",
    "i18n:merge": "tsx --tsconfig scripts/tsconfig.json scripts/i18n-overlay.ts merge",
    "social:studio": "remotion studio tools/social-engine/index.ts --config=tools/social-engine/remotion.config.ts --public-dir=public",
    "social:render": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/render.ts",
    "social:validate": "tsc -p tools/social-engine/tsconfig.json && tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/tests/run.ts",
    "social:catalog": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/catalog.ts",
    "social:schema": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/schema.ts",
    "social:queue": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/queue.ts",
    "social:validate:queue": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/validate-queue.ts",
    "social:render:queue": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/render-queue.ts",
    "social:retry:failed": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/render-queue.ts --retry-failed",
    "social:render:queue:dry": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/render-queue.ts --dry-run",
    "social:ci:report": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/ci-report.ts",
    "social:publication:validate": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/publication.ts validate",
    "social:publication:apply": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/publication.ts apply",
    "social:publication:apply:dry": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/publication.ts apply --dry-run",
    "social:publication:list": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/publication.ts list",
    "social:publication:check-scope": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/cli/publication.ts check-scope",
    "social:publication:test": "tsx --tsconfig tools/social-engine/tsconfig.json tools/social-engine/tests/run-publication.ts"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.3.5",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^6.27.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@types/node": "^25.9.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "playwright": "^1.56.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "remotion": "4.0.530",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
